TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Comma-separated Telegram user IDs allowed to use the bot. Empty = nobody.
# Send /start to the bot to see your own ID.
ALLOWED_USER_IDS=

# Whisper model for subtitles: tiny | base | small | medium | large
# (medium = good for EN/RU; tiny/base are much faster on CPU)
WHISPER_MODEL=medium

# Folders (defaults live under ./data)
# DATA_DIR=./data
# INBOX_DIR=./data/inbox     # drop large videos here, pick them with /inbox
# MUSIC_DIR=./data/music     # mp3/wav background tracks
# OUTPUT_DIR=./data/output

# Optional: self-hosted Telegram Bot API server (lifts the 20 MB download / 50 MB upload limits)
# TELEGRAM_API_BASE_URL=http://localhost:8081
# TELEGRAM_UPLOAD_LIMIT_MB=50
